# Enquiry delivery (Workstream A) — copy to .env.local and fill in.
# Do NOT commit real secrets. Leave these blank locally to use the safe
# "accept + minimal non-PII log" dev fallback (no email is sent).

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for accepted enquiries (the private membership desk).
ENQUIRY_TO_EMAIL=

# Verified sender address (must be on a Resend-verified domain).
ENQUIRY_FROM_EMAIL=

# Optional — Upstash Redis for distributed rate limiting. If either is absent,
# the endpoint falls back to a per-instance in-memory limiter (dev-only).
# https://upstash.com/docs/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
